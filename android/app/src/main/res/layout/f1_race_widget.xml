<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_race_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@drawable/f1_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下一场比赛"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_race_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="下一场大奖赛"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_race_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="打开 App 获取最新赛历"
            android:textColor="#BFFFFFFF"
            android:textSize="11sp" />
        <Chronometer
            android:id="@+id/widget_race_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:format="%s"
            android:text="--:--:--"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
